{
  "name": "@campfire/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "篝火智答 React H5（一期唯一前端）",
  "scripts": {
    "dev": "node scripts/sync-tokens.mjs && vite",
    "build": "node scripts/sync-tokens.mjs && tsc --noEmit && vite build",
