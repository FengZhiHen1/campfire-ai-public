# ============================================================
# 生产环境变量模板（复制为 .env.prod 后填真实值）
#
#   cp .env.example.prod .env.prod   # 然后逐项填入真实凭据
#
# ⚠️ `.env.prod` **不得提交**（`.gitignore` 已忽略 `.env.*`，仅放行 `.example`）。
# ⚠️ 本文件里所有 `CHANGE_ME` 都是占位符。**占位凭据进生产等于没有凭据**：
#    dev 的 `.env` 里实测就是 `changeme` / `change-me-to-a-random-secret` / `minioadmin`。
# ⚠️ `docker-compose.prod.yml` 对关键项用了 `${VAR:?}`，缺值会**启动失败**而不是
#    静默取默认值——这是刻意的（默认值会静默生效，缺值会立刻报错）。
#
# 分段说明（与 `.env.example` 的三段标注同法）：
#   ① 数据服务与编排读取
#   ② 应用读取（后端）
#   ③ 构建期读取（前端）
# ============================================================

# --- ① 数据服务与编排读取 ---

# PostgreSQL：全部业务数据、会话表与 SuperTokens core 的表都在这个库里。
POSTGRES_USER=campfire
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=campfire

# Redis：缓存、限流与 Taskiq 队列。生产必须设密码（compose 里强制）。
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# FalkorDB：Graphiti 长期记忆。生产必须设密码（compose 里强制）。
FALKORDB_PASSWORD=CHANGE_ME_strong_falkordb_password

# SuperTokens core 的 Management API 密钥。core 启动时若配置了 API_KEYS，
# 未带该 key 的请求会被拒（实测 401 Invalid API key），SDK 因此连建号都做不了。
SUPERTOKENS_API_KEY=CHANGE_ME_supertokens_management_key

# 镜像引用。`IMAGE_API` / `IMAGE_WEB` 是**仓库地址**（不含 tag），`IMAGE_TAG` 是版本。
#
# ⚠️ 三者的关系不能省（2026-10-01 修正）：compose 的 `image:` 是
#   `${IMAGE_API:-campfire-api}:${IMAGE_TAG:-local}`
# 若只给 `IMAGE_TAG` 而不给 `IMAGE_API`，compose 会去找 `docker.io/library/campfire-api`——
# 那是本地构建名，与 GHCR 上推的 `ghcr.io/<owner>/<repo>/api` 不同名，`pull` 永远拉不到。
# CD 的 release 作业会自动写入这三行；手工部署时按下面的形状填。
#
# CI/CD 用 git SHA 作 tag，便于按提交回滚。
IMAGE_API=ghcr.io/CHANGE_ME_owner/CHANGE_ME_repo/api
IMAGE_WEB=ghcr.io/CHANGE_ME_owner/CHANGE_ME_repo/web
IMAGE_TAG=local

# --- ② 应用读取（后端）---
#
# 注意：`DATABASE_URL` / `REDIS_URL` / `FALKORDB_HOST` / `FALKORDB_PORT` /
# `SUPERTOKENS_CONNECTION_URI` 由 `docker-compose.prod.yml` 的 `environment`
# 按服务名覆盖（容器内网寻址），因此**不必**在这里配——在这里配反而容易被
# 误写成 localhost 而连不上。这里只放那些不被 compose 覆盖的项。

APP_ENV=production
LOG_LEVEL=INFO

# 模型路由（腾讯云 TokenHub）。接口地址与开通地域绑定，不支持跨地域调用。
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
TOKENHUB_API_KEY=CHANGE_ME_tokenhub_api_key
MODEL_NAME=deepseek-v4.1-flash
EMBEDDING_MODEL_NAME=kinfra-text-embedding-4b

# 模型调用预算（默认值已落在 180 秒通用响应上限内；改小不改大）。
MODEL_REQUEST_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=2
MODEL_RETRY_INITIAL_DELAY_SECONDS=1.0
MODEL_RETRY_MAX_DELAY_SECONDS=8.0

# 压缩阈值算术的两个输入。
MODEL_CONTEXT_WINDOW_TOKENS=1048576
MODEL_OUTPUT_RESERVE_TOKENS=8192

# ⚠️ SuperTokens 的对外地址：**生产必须改成真实域名**。
# 不设时会按默认值 `http://localhost:8000` / `http://localhost:5173` 做
# same-site 判定与 cookie 域推导，导致浏览器里登录态不生效（cookie 域不匹配）。
# 一期前后端同顶级域，经同一 Nginx 暴露。
SUPERTOKENS_API_DOMAIN=https://CHANGE_ME.example.com
SUPERTOKENS_WEBSITE_DOMAIN=https://CHANGE_ME.example.com
# 与 `core/config.py` 的默认值、以及前端 `infrastructure/auth/session.ts` 的
# `apiBasePath` 必须一致：2026-10-01 起业务接口与认证一起收进 `/api` 前缀
# （页面在 `/consult`、接口在 `/api/consult`，结构上不再相撞）。
# ⚠️ 此处原写 `/auth`，是前缀改造的漏网值：照抄会让后端把 SDK 挂到 `/auth`，
# 而前端去请求 `/api/auth`，表现为**登录 404**。
SUPERTOKENS_API_BASE_PATH=/api/auth

# 引用索引单次操作超时（秒）。有界：它慢会拖住整次运行，而运行另有 180 秒上限。
CITATION_TIMEOUT_SECONDS=5.0

# 图库操作超时与并发上界。应急预注入在首字时延路径上，图库慢必须尽快落进降级分支。
FALKORDB_TIMEOUT_SECONDS=5.0
FALKORDB_MAX_COROUTINES=20
FALKORDB_DATABASE=campfire

# skill 内容根目录。镜像内默认指向 /app/apps/api/skills（已随镜像打包），
# 因此通常不必设置。留空即用默认值。
# SKILL_ROOT=

# --- ③ 构建期读取（前端）---
#
# `VITE_API_DOMAIN` 经 `import.meta.env` **构建期内联**进产物，因此它不是运行期
# 配置：改它必须重新构建 web 镜像。它只用于 supertokens-web-js 的 init，
# 业务请求走同源相对路径。填对外站点地址（与 SUPERTOKENS_*_DOMAIN 一致）。
PUBLIC_BASE_URL=https://CHANGE_ME.example.com
