# ============================================================
# 篝火智答 (Campfire-AI) — 环境变量模板
# 复制为 .env 后填入真实值。.env 文件不进入 Git。
#
# 分四段：
#   ① 应用读取 —— apps/api/src/campfire/core/config.py（配置唯一入口）
#   ② docker compose 读取 —— 只被编排消费，应用代码不读
#   ③ 设计已定、当前代码尚无消费者 —— 列出以免遗漏，接入时再启用
#   ④ 开发工具读取 —— marketing 的采集脚本，不进应用、不进编排
# ============================================================

# ---------- ① 应用读取（core/config.py）----------

# --- 数据主库 PostgreSQL 17 + pgvector ---
# SuperTokens core 的表也在本库内（见 docs/技术栈设计.md 第 4 节）。
DATABASE_URL=postgresql+asyncpg://campfire:changeme@localhost:5432/campfire

# --- Redis 7（缓存、限流与 Taskiq broker 队列）---
REDIS_URL=redis://localhost:6379/0
TASKIQ_QUEUE_NAME=campfire

# --- 模型（腾讯云 TokenHub）---
# 接口地址与开通地域绑定，不支持跨地域调用（见 docs/技术栈设计.md 第 6 节）。
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
TOKENHUB_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 全应用单一模型（见 docs/技术栈设计.md 第 3 节）；业务代码不得硬编码模型名。
MODEL_NAME=deepseek-v4.1-flash
# RAG 侧嵌入模型名（见 docs/技术设计/technical-details/RAG策略.md 第 2 节）。
# 与上面的 TOKENHUB_BASE_URL / TOKENHUB_API_KEY 共用，不引入第二个供应商的凭据。
# 维度固定 2560 且**不可配置**（常数在 modules/library）——换模型必须整库重建。
EMBEDDING_MODEL_NAME=kinfra-text-embedding-4b
# 单次请求超时与重试上界。最坏组合（超时 × 尝试次数 + 退避之和）必须落在基座第 2 节
# 的 180 秒通用响应上限内，否则重试会被运行上限从中间砍断；越界时 agent.model 在
# 构造期即报错。默认值最坏 45×3 + 1 + 2 = 138 秒。
MODEL_REQUEST_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=2
MODEL_RETRY_INITIAL_DELAY_SECONDS=1
MODEL_RETRY_MAX_DELAY_SECONDS=8
# --- 压缩阈值算术的两个输入（压缩策略第 2、10 节）---
# W：模型上下文上限（2026-09-29 经用户确认为 1024k = 1,048,576）。
MODEL_CONTEXT_WINDOW_TOKENS=1048576
# O：为输出预留的额度，代入阈值公式 floor(min(W×0.8, W−O−headroom))。
# 注意：基座第 2 节不设 token 上限，我们**不**在请求上写 max_tokens——O 是预算假设，不是截断值。
MODEL_OUTPUT_RESERVE_TOKENS=8192
# 注意（已实测）：若宿主机 no_proxy 含带方括号的 IPv6 字面量（如 [::1]），httpx 会在
# 构造客户端时抛 InvalidURL，模型调用与健康探针都会失败。去掉方括号写法即可。

# --- 认证（SuperTokens core）---
# ⚠️ **core 在鉴权关键路径上**（2026-09-29 裁决，见 docs/技术设计/decisions/
# 会话校验逐请求查证数据库.md）：会话校验以 check_database=True **逐请求查证数据库**，
# 而该查证由 core 执行。core 不可用时，注册、登录、重置、刷新**以及全部受限操作**
# 都不可用（fail-closed）。此前本行写「会话校验在 Python SDK 内完成、不经过 core」，
# 该表述**已被推翻**。
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
# SDK 的装配参数（core/config.py 读取）。API_DOMAIN/WEBSITE_DOMAIN 用于 same-site 判定
# 与 cookie 域推导；一期前后端同顶级域，经同一 Nginx 暴露（技术栈设计第 6 节）。
# 部署时必须改成真实域名，否则 cookie 的 sameSite 判定与实际站点不符。
SUPERTOKENS_API_DOMAIN=http://localhost:8000
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:5173

# --- 通用记忆（Graphiti + FalkorDB）---
# 端口与 docker-compose 的宿主机映射一致（6380:6379，避开 Redis 自己的 6379）。
# 图库名固定一个：记忆按账号分区靠 group_id，不靠分库；分库会让账号隔离与
# 「一次查询一个分区」的设计同时失效。
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_DATABASE=campfire
# 本地容器默认无密码；生产必须设置（留空即无密码连接）。
# FALKORDB_PASSWORD=
# 单次图库操作超时（秒）。有界：应急预注入在首字时延路径上，图库慢时必须尽快
# 落进「明确标注不可用」的降级分支，而不是拖住整次运行。
FALKORDB_TIMEOUT_SECONDS=5
# 图库并发上界，显式传入（Graphiti 默认读环境变量 SEMAPHORE_LIMIT，不随环境漂移）。
FALKORDB_MAX_COROUTINES=20

# --- 应用 ---
APP_ENV=development
LOG_LEVEL=INFO
# skill 内容根目录；留空则用应用内默认（apps/api/skills）
# SKILL_ROOT=

# ---------- ② docker compose 读取 ----------

POSTGRES_USER=campfire
POSTGRES_PASSWORD=changeme
POSTGRES_DB=campfire

# SuperTokens core 的 Management API 密钥（compose 传为 API_KEYS）。
# **实测必须与容器一致**：core 以 API_KEYS 启动时，不带它的请求会被拒
# （GET /apiversion → 401 Invalid API key），SDK 在**建号第一步**就失败。
# 应用侧（core/config.py 的 supertokens_api_key）读的就是同一个变量；
# 未配置时 SDK 装配期显式报错，不静默降级。
SUPERTOKENS_API_KEY=change-me-to-a-random-secret

# MinIO 对象存储（一期不依赖附件，编排保留）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---------- ③ 设计已定、当前代码尚无消费者 ----------
# 列出以免遗漏。对应模块落地时在此启用，并在 core/config.py 加上字段——
# 不预先加空字段，避免配置面出现没有消费者的第二真相。

# supertokens-python SDK 的凭据随 surfaces/accounts 落地时加入（健康探针不需要它）。

# ---------- ④ 开发工具读取（marketing 采集脚本）----------

# marketing/promo-shotcraft/capture/*.mjs 用演示账号登录本地 dev 服务后出图。
# 账号名是文档化的虚构演示账号（演示种子数据见 marketing/promo-shotcraft/DESIGN_SPEC.md），
# 本身不敏感，故给出缺省值。
# 口令不入库：留空则脚本在启动时显式报错，不静默降级成一个默认口令。
# 运行方式（在 marketing/promo-shotcraft/ 下；`account.mjs` 是各采集脚本共用的账号模块）：
#   node --env-file=../../.env capture/capture.mjs
CAPTURE_ACCOUNT=demo-parent
CAPTURE_PASSWORD=
